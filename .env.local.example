# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend (email) ────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=office@thegasologist.com

# ── Twilio (SMS reminders) ────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Google Calendar ───────────────────────────────────────────
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REFRESH_TOKEN=1//...
GOOGLE_CALENDAR_ID=office@thegasologist.com

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://thegasologist.com
ADMIN_EMAIL=office@thegasologist.com

# ── Cron Security ─────────────────────────────────────────────
# Generate a random string: openssl rand -hex 32
CRON_SECRET=your_random_secret_here

# ── ScraperAPI (finish-link image/price pull) ─────────────────
# Free tier at https://www.scraperapi.com (1,000 req/mo, no card).
# Lets finish links pull image + price from retailers that block plain
# server fetches (Home Depot, Lowe's, Wayfair). Optional — links that
# aren't bot-blocked still work without it.
SCRAPER_API_KEY=
# Optional: override the proxy params if a site still blocks (e.g. hard
# sites may need ultra_premium). Default: render=true&country_code=us
# SCRAPER_API_PARAMS=render=true&ultra_premium=true&country_code=us
